# ============================================================================
# AWS SageMaker Integration Settings (Copy to `.env` locally or Render Env tab)
# ============================================================================
USE_AWS_SAGEMAKER=true
AWS_REGION=us-east-1
SAGEMAKER_ENDPOINT_NAME=thermox-ai-endpoint
S3_BUCKET=sagemaker-us-east-1-721093132276
S3_PREFIX=thermox-ai
SAGEMAKER_ROLE_ARN=arn:aws:iam::721093132276:role/SageMakerBuildingEnargyRole

# IAM User Access Keys (Keep private! Never commit real keys to GitHub)
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
